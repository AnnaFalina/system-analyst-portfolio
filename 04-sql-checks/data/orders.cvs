CREATE TABLE pickup_points (
    id INTEGER PRIMARY KEY,
    name TEXT
);

INSERT INTO pickup_points (id, name) VALUES
(1, 'Пункт приема №1 - Центральный'),
(2, 'Пункт приема №2 - Северный'),
(3, 'Пункт приема №3 - Южный'),
(4, 'Пункт приема №4 - Проспект'),
(5, 'Пункт приема №5 - Вокзальный');

CREATE TABLE orders (
    id INTEGER PRIMARY KEY,
    pickup_point_id INTEGER REFERENCES pickup_points(id),
    tariff TEXT,
    status TEXT,
    order_date DATE,
    ready_date DATE,
    pickup_date DATE,
    amount INTEGER
);

